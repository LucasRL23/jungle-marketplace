{
  "name": "jungle-marketplace",
  "packageManager": "pnpm@11.25.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:e2e": "pnpm build && playwright test",
    "test:report": "playwright show-report",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "dev:mocks": "vite",
    "format": "prettier --write src tests scripts *.ts *.json *.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md"
  },
  "dependencies": {
    "@fontsource-variable/roboto-mono": "^5.3.0",
    "@mswjs/socket.io-binding": "^0.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "msw": "^2.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lighthouse": "^13.5.0",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
